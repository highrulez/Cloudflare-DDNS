NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8090
# Replace with your public HTTPS origin (Synology Reverse Proxy hostname).
APP_ORIGIN=https://ddns.example.com
# Exact browser origins allowed to call mutating APIs. Always includes APP_ORIGIN.
# Include your LAN diagnostics origin if you use direct :8090 access from the browser.
APP_ALLOWED_ORIGINS=https://ddns.example.com,http://192.0.2.10:8090
TZ=UTC
LOG_LEVEL=info
APP_VERSION=1.0.0
GIT_COMMIT=unknown
BUILD_DATE=unknown
CONFIG_VERSION=1

# Existing Synology MariaDB 10 database. Replace user, password, host, port, and database name.
# Preserve your verified address when enabling host networking.
# In host mode, 127.0.0.1 refers to the Synology host, but do not switch to it until MariaDB TCP
# binding and user grants have been verified. Confirm the MariaDB TCP port used by your NAS.
# URL-encode reserved characters in the password.
DATABASE_URL=mysql://ddns_app:CHANGE_ME@127.0.0.1:3306/infrahub

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=GENERATE_YOUR_OWN_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=GENERATE_YOUR_OWN_SECRET

COOKIE_NAME=cloudflare_ddns_session
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
IPV4_PROVIDERS=https://api4.ipify.org,https://checkip.amazonaws.com,https://ipv4.icanhazip.com
IPV6_PROVIDERS=https://api6.ipify.org,https://ipv6.icanhazip.com,https://v6.ident.me
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
HTTP_TIMEOUT_MS=10000

# Cloudflare Turnstile (Managed mode, action=login). Site key is public; secret is server-only.
# Production admin login should use your public HTTPS hostname. TURNSTILE_EXPECTED_HOSTNAME must match it.
# Direct LAN :8090 access remains useful for diagnostics/health; do not weaken Turnstile for LAN.
# Local/automated tests: use Cloudflare official test keys (never production keys in CI).
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
TURNSTILE_EXPECTED_HOSTNAME=ddns.example.com
TURNSTILE_EXPECTED_ACTION=login
TURNSTILE_VERIFY_TIMEOUT_MS=5000
