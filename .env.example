NODE_ENV=production
API_PORT=3000
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Bundled MySQL defaults. Replace every value in production.
MYSQL_DATABASE=infrastructure_hub
MYSQL_USER=infra_hub
MYSQL_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
DATABASE_URL=mysql://infra_hub:replace-with-a-long-database-password@mysql:3306/infrastructure_hub

# Use redis://:password@host:6379 for an external Redis instance.
REDIS_PASSWORD=replace-with-a-long-redis-password
REDIS_URL=redis://:replace-with-a-long-redis-password@redis:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_ENCRYPTION_KEY_VERSION=1

# Used only to create the first local administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-character-password

SESSION_TTL_SECONDS=43200
COOKIE_NAME=infra_hub_session
COOKIE_SECURE=false
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
PUBLIC_IPV4_URL=https://api.ipify.org
PUBLIC_IPV6_URL=https://api6.ipify.org
LOG_LEVEL=info
