NODE_ENV=production
HOST_PORT=8090
APP_PORT=3000
APP_ORIGIN=http://192.168.1.10:8090
TZ=Asia/Kuala_Lumpur
LOG_LEVEL=info

# Existing Synology MariaDB 10 database. Use the NAS LAN address, not localhost.
# Synology MariaDB 10 commonly uses port 3307; confirm the configured TCP port.
DATABASE_URL=mysql://cloudflare_ddns:replace-with-a-url-encoded-password@192.168.1.10:3307/cloudflare_ddns

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-canonical-base64-for-32-random-bytes
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

COOKIE_NAME=cloudflare_ddns_session
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
IPV4_PROVIDERS=https://api.ipify.org,https://checkip.amazonaws.com,https://icanhazip.com
IPV6_PROVIDERS=https://api6.ipify.org,https://icanhazip.com
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
HTTP_TIMEOUT_MS=10000
