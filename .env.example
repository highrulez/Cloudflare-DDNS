NODE_ENV=production
API_PORT=3000
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://192.168.68.100:8080

# Existing Synology MariaDB. Put the real URL-encoded password only in .env.
DATABASE_URL=mysql://infrahub_app:REPLACE_WITH_URL_ENCODED_PASSWORD@192.168.68.100:3306/infrahub
DB_STARTUP_MAX_ATTEMPTS=60
DB_STARTUP_RETRY_SECONDS=2

# Redis is required for sessions, queues, caching, and scheduled jobs.
REDIS_PASSWORD=replace-with-a-long-redis-password
REDIS_URL=redis://:replace-with-a-long-redis-password@redis:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_ENCRYPTION_KEY_VERSION=1

# Used only to create the first local administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-character-password

SESSION_TTL_SECONDS=43200
COOKIE_NAME=infra_hub_session
COOKIE_SECURE=false
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
PUBLIC_IPV4_URL=https://api.ipify.org
PUBLIC_IPV6_URL=https://api6.ipify.org
LOG_LEVEL=info
