generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RecordType {
  A
  AAAA
}
enum RecordHealth {
  UNKNOWN
  HEALTHY
  DRIFTED
  ERROR
  DISABLED
}
enum IpFamily {
  IPV4
  IPV6
}
enum RunTrigger {
  SCHEDULED
  MANUAL_CHECK
  MANUAL_UPDATE
  FORCE
  SETUP
}
enum RunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}
enum UpdateAction {
  CHECKED
  SKIPPED
  UPDATED
  CREATED
  FAILED
  DISABLED
  STOPPED_MANAGING
  DELETED
  NO_IP
}
enum UpdateResult {
  SUCCESS
  ERROR
  UNCHANGED
}
enum AuthAuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_RATE_LIMITED
  TURNSTILE_FAILED
  LOGOUT
  SESSION_EXPIRED
  MFA_ENROLLMENT_STARTED
  MFA_ENABLED
  MFA_CHALLENGE_FAILED
  MFA_LOGIN_SUCCESS
  MFA_RECOVERY_CODE_USED
  MFA_RECOVERY_CODES_REGENERATED
  MFA_DISABLED
  REAUTH_SUCCESS
  REAUTH_FAILED
  REAUTH_RATE_LIMITED
  CLOUDFLARE_CREDENTIAL_ADDED
  CLOUDFLARE_CREDENTIAL_CHANGED
  CLOUDFLARE_CONNECTION_REMOVED
  DNS_RECORD_DELETED
  PASSWORD_CHANGED
  SECURITY_SETTING_CHANGED
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique @db.VarChar(191)
  passwordHash        String            @db.VarChar(255)
  mfaEnabled          Boolean           @default(false)
  mfaSecretCiphertext Bytes?
  mfaSecretIv         Bytes?
  mfaSecretAuthTag    Bytes?
  mfaSecretKeyVersion Int?
  mfaEnabledAt        DateTime?
  mfaLastUsedStep     BigInt?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sessions            Session[]
  recoveryCodes       MfaRecoveryCode[]
  mfaChallenges       MfaChallenge[]
  mfaEnrollment       MfaEnrollment?
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, usedAt])
}

model MfaChallenge {
  id             String    @id @default(cuid())
  tokenHash      String    @unique @db.Char(64)
  userId         String
  expiresAt      DateTime
  failedAttempts Int       @default(0)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model MfaEnrollment {
  id               String   @id @default(cuid())
  userId           String   @unique
  secretCiphertext Bytes
  secretIv         Bytes
  secretAuthTag    Bytes
  secretKeyVersion Int      @default(1)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthAuditEvent {
  id        String             @id @default(cuid())
  type      AuthAuditEventType
  success   Boolean
  sourceIp  String?            @db.VarChar(64)
  userAgent String?            @db.VarChar(512)
  username  String?            @db.VarChar(191)
  createdAt DateTime           @default(now())
  @@index([createdAt])
  @@index([type])
}

model Session {
  id                          String    @id @default(cuid())
  tokenHash                   String    @unique @db.Char(64)
  userId                      String
  expiresAt                   DateTime
  lastSeenAt                  DateTime  @default(now())
  stronglyAuthenticatedUntil  DateTime?
  createdAt                   DateTime  @default(now())
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model SetupState {
  id          Int      @id @default(1)
  step        Int      @default(1)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CloudflareAccount {
  id              String             @id @default(cuid())
  name            String             @unique @db.VarChar(191)
  tokenCiphertext Bytes
  tokenIv         Bytes
  tokenAuthTag    Bytes
  tokenKeyVersion Int                @default(1)
  tokenHint       String             @db.VarChar(32)
  verifiedAt      DateTime?
  lastError       String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  zones           CloudflareZone[]
  records         ManagedDnsRecord[]
}

model CloudflareZone {
  id          String            @id @default(cuid())
  accountId   String
  cloudflareId String           @db.VarChar(64)
  name        String            @db.VarChar(253)
  status      String            @db.VarChar(32)
  recordCount Int               @default(0)
  lastSyncedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  account     CloudflareAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  records     ManagedDnsRecord[]
  @@unique([accountId, cloudflareId])
  @@unique([id, accountId])
  @@index([name])
}

model ManagedDnsRecord {
  id                  String            @id @default(cuid())
  accountId           String
  zoneId              String
  cloudflareRecordId  String?           @db.VarChar(64)
  type                RecordType
  hostname            String            @db.VarChar(253)
  normalizedHostname  String            @db.VarChar(253)
  content             String?           @db.VarChar(45)
  proxied             Boolean           @default(false)
  ttl                 Int               @default(1)
  enabled             Boolean           @default(true)
  automatic           Boolean           @default(true)
  health              RecordHealth      @default(UNKNOWN)
  lastCheckedAt       DateTime?
  lastUpdatedAt       DateTime?
  lastError           String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  account             CloudflareAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  zone                CloudflareZone    @relation(fields: [zoneId, accountId], references: [id, accountId], onDelete: Restrict)
  logs                DdnsUpdateLog[]
  @@unique([accountId, zoneId, normalizedHostname, type])
  @@unique([zoneId, cloudflareRecordId])
  @@index([enabled, type])
}

model AppSettings {
  id                 Int      @id @default(1)
  intervalMinutes    Int      @default(5)
  ipv4Enabled        Boolean  @default(true)
  ipv6Enabled        Boolean  @default(false)
  automaticUpdates   Boolean  @default(true)
  providerPolicy     String   @default("ordered") @db.VarChar(32)
  ipv4Providers      Json?
  ipv6Providers      Json?
  requestTimeoutMs   Int      @default(5000)
  retentionDays      Int      @default(90)
  timezone           String   @default("Asia/Kuala_Lumpur") @db.VarChar(64)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model IpDetectionRun {
  id          String              @id @default(cuid())
  ddnsRunId   String?
  startedAt   DateTime            @default(now())
  finishedAt  DateTime?
  ipv4        String?             @db.VarChar(45)
  ipv6        String?             @db.VarChar(45)
  ipv4Status  String?             @db.VarChar(32)
  ipv6Status  String?             @db.VarChar(32)
  success     Boolean             @default(false)
  ddnsRun     DdnsRun?            @relation(fields: [ddnsRunId], references: [id], onDelete: SetNull)
  results     IpDetectionResult[]
  @@index([startedAt])
}

model IpDetectionResult {
  id          String         @id @default(cuid())
  runId       String
  family      IpFamily
  provider    String         @db.VarChar(255)
  success     Boolean
  address     String?        @db.VarChar(45)
  error       String?        @db.Text
  durationMs  Int
  createdAt   DateTime       @default(now())
  run         IpDetectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId, family])
}

model DdnsRun {
  id             String           @id @default(cuid())
  trigger        RunTrigger
  status         RunStatus        @default(RUNNING)
  force          Boolean          @default(false)
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  recordsTotal   Int              @default(0)
  recordsUpdated Int              @default(0)
  recordsFailed  Int              @default(0)
  summary        String?          @db.Text
  ipRuns         IpDetectionRun[]
  logs           DdnsUpdateLog[]
  @@index([startedAt])
  @@index([status])
}

model DdnsUpdateLog {
  id               String            @id @default(cuid())
  runId            String
  recordId         String?
  hostname         String            @db.VarChar(253)
  type             RecordType
  previousIp       String?           @db.VarChar(45)
  newIp            String?           @db.VarChar(45)
  action           UpdateAction
  result           UpdateResult
  providerRequestId String?          @db.VarChar(128)
  providerResponse String?           @db.Text
  error            String?           @db.Text
  durationMs       Int
  createdAt        DateTime          @default(now())
  run              DdnsRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  record           ManagedDnsRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  @@index([runId])
  @@index([recordId, createdAt])
  @@index([result, createdAt])
}

model SchedulerLease {
  name          String   @id @db.VarChar(64)
  ownerId       String   @db.VarChar(128)
  leaseExpiresAt DateTime
  heartbeatAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SchedulerState {
  id          Int      @id @default(1)
  ownerId     String?  @db.VarChar(128)
  running     Boolean  @default(false)
  lastCheckAt DateTime?
  nextCheckAt DateTime?
  lastRunId   String?  @db.VarChar(191)
  lastError   String?  @db.Text
  updatedAt   DateTime @updatedAt
}
