NODE_ENV=production
HOST_PORT=8090
APP_PORT=3000
APP_ORIGIN=http://192.168.1.10:8090
TZ=Asia/Kuala_Lumpur
LOG_LEVEL=info

DB_NAME=cloudflare_ddns
DB_USER=cloudflare_ddns
DB_PASSWORD=replace-with-a-long-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password
DATABASE_URL=mysql://cloudflare_ddns:replace-with-a-url-encoded-database-password@db:3306/cloudflare_ddns

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-canonical-base64-for-32-random-bytes
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

COOKIE_NAME=cloudflare_ddns_session
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
IPV4_PROVIDERS=https://api.ipify.org,https://checkip.amazonaws.com,https://icanhazip.com
IPV6_PROVIDERS=https://api6.ipify.org,https://icanhazip.com
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
HTTP_TIMEOUT_MS=10000
