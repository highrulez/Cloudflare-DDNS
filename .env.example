NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8090
APP_ORIGIN=https://dns.highrulez.com
# Exact browser origins allowed to call mutating APIs. Always includes APP_ORIGIN.
APP_ALLOWED_ORIGINS=https://dns.highrulez.com,http://192.168.68.100:8090
TZ=Asia/Kuala_Lumpur
LOG_LEVEL=info
APP_VERSION=1.0.0
GIT_COMMIT=unknown
BUILD_DATE=unknown
CONFIG_VERSION=1

# Existing Synology MariaDB 10 database. Preserve your verified address when enabling host networking.
# In host mode, 127.0.0.1 refers to the Synology host, but do not switch to it until MariaDB TCP
# binding and user grants have been verified.
# Synology MariaDB 10 commonly uses port 3307; confirm the configured TCP port.
DATABASE_URL=mysql://cloudflare_ddns:replace-with-a-url-encoded-password@192.168.1.10:3307/cloudflare_ddns

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-canonical-base64-for-32-random-bytes
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

COOKIE_NAME=cloudflare_ddns_session
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
IPV4_PROVIDERS=https://api4.ipify.org,https://checkip.amazonaws.com,https://ipv4.icanhazip.com
IPV6_PROVIDERS=https://api6.ipify.org,https://ipv6.icanhazip.com,https://v6.ident.me
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
HTTP_TIMEOUT_MS=10000
